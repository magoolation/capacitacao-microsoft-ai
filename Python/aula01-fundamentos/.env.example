# Endpoint DO PROJETO Foundry (não o endpoint /openai/v1 do recurso)
FOUNDRY_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<projeto>
# Nome do DEPLOYMENT do modelo de chat (não o nome comercial do modelo)
FOUNDRY_MODEL=<nome-do-deployment-do-modelo>
# GUID do tenant — evita o DefaultAzureCredential escolher o tenant errado
AZURE_TENANT_ID=<guid-do-tenant>
