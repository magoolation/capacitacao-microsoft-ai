{
  "profiles": {
    "CapacitacaoMicrosoftAIObservabilidade": {
      "commandName": "Project",
      "environmentVariables": {
        "FOUNDRY_MODEL": "<nome-do-deployment-do-modelo>",
        "FOUNDRY_ENDPOINT": "https://<recurso>.services.ai.azure.com/api/projects/<projeto>",
        "FOUNDRY_JUDGE_MODEL": "<deployment-do-modelo-juiz (opcional; padrao: FOUNDRY_MODEL)>",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "<opcional: se vazio, o programa pergunta ao projeto Foundry>",
        "AZURE_TENANT_ID": "<guid-do-tenant>",
        "AZURE_TOKEN_CREDENTIALS": "AzureCliCredential"
      }
    }
  }
}
